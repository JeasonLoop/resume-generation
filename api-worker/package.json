{
  "name": "resume-generation-worker-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply resume_generation --local",
    "db:migrate:remote": "wrangler d1 migrations apply resume_generation --remote",
    "db:generate": "drizzle-kit generate",
    "deploy:one-click": "npm run db:migrate:remote && npm run deploy"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "drizzle-orm": "^0.44.6",
    "hono": "^4.10.1",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260405.0",
    "@types/jsonwebtoken": "^9.0.10",
    "drizzle-kit": "^0.31.5",
    "typescript": "^5.9.3",
    "wrangler": "^4.13.2"
  }
}
